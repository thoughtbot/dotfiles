{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(brew *)",
      "Bash(git *)",
      "Bash(pnpm test *)",
      "Bash(ax *)",
      "Bash(crit *)",
      "Bash(scapple *)",
      "Bash(claude mcp *)",
      "Bash(claude plugin *)",
      "Bash(man *)",
      "Bash(col *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(tr *)",
      "Bash(cat *)",
      "Bash(ps *)",
      "Bash(date *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(readlink *)",
      "Bash(cd *)",
      "Bash(llm-wiki *)",
      "Read(~/.claude/skills/**)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch(domain:crit.md)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:docs.renovatebot.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebFetch(domain:direnv.net)",
      "WebFetch(domain:dprint.dev)",
      "WebFetch(domain:formulae.brew.sh)",
      "WebFetch(domain:docs.brew.sh)",
      "WebFetch(domain:git-scm.com)"
    ],
    "deny": [
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api graphql *)",
      "Bash(git checkout *)",
      "Bash(git -C *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git tag -d *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * -d)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean *-f*)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "ask": [
      "Bash(gh api *)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push * origin main*)",
      "Bash(git push * origin master*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/validate-commit-message.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-status"
  },
  "enabledPlugins": {
    "crit@crit": true,
    "product-skills@claude-code-skills": true,
    "skill-scanner@skillplugs": true,
    "dig@kuu-marketplace": true,
    "fix-ci@kuu-marketplace": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    },
    "skillplugs": {
      "source": {
        "source": "github",
        "repo": "skillplugs/plugins"
      }
    },
    "kuu-marketplace": {
      "source": {
        "source": "github",
        "repo": "fumiya-kume/claude-code"
      }
    }
  },
  "language": "japanese",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "effortLevel": "medium"
}
